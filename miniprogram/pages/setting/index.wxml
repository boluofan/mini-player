<navigation-bar title="设置" />

<scroll-view class="flex-1 overflow-y-hidden px-3 box-border" scroll-y show-scrollbar="{{false}}">
  <view class="mt-4">
    <view class="text-xs text-gray-400 uppercase mb-2">服务器</view>
    <view class="bg-white dark:bg-gray-800/20 rounded-xl p-3">
      <view class="flex justify-between items-center py-2">
        <text class="text-sm">服务器地址</text>
        <text class="text-sm text-gray-500 truncate max-w-[200px]">{{serverUrl}}</text>
      </view>
    </view>
  </view>

  <view class="mt-4">
    <view class="text-xs text-gray-400 uppercase mb-2">设备</view>
    <view class="bg-white dark:bg-gray-800/20 rounded-xl p-3">
      <view class="flex justify-between items-center py-2">
        <text class="text-sm">Miot 插件</text>
        <text class="text-sm" wx:if="{{hasMiot}}">已连接</text>
        <text class="text-sm text-gray-500" wx:else>未检测到</text>
      </view>
      <view wx:if="{{hasMiot}}" class="border-t border-gray-100 dark:border-gray-700/50 pt-2 mt-1">
        <text class="text-xs text-gray-400 mb-2 block">选择播放设备</text>
        <view class="flex items-center py-2.5 rounded-lg {{did === 'host' ? 'bg-blue-50 dark:bg-blue-900/20' : ''}}" data-deviceid="host" bind:tap="selectDevice">
          <view class="w-5 h-5 rounded-full border-2 flex items-center justify-center mr-3 {{did === 'host' ? 'border-blue-500' : 'border-gray-300'}}">
            <view wx:if="{{did === 'host'}}" class="w-2.5 h-2.5 rounded-full bg-blue-500"></view>
          </view>
          <text class="text-sm {{did === 'host' ? 'text-blue-600 font-medium' : ''}}">📱 本机播放</text>
        </view>
        <block wx:for="{{deviceGroups}}" wx:key="account_id">
          <view class="text-xs text-gray-400 mt-2 mb-1">{{item.account_name || item.account_id}}</view>
          <view class="flex items-center py-2.5 rounded-lg {{did === item.deviceID ? 'bg-blue-50 dark:bg-blue-900/20' : ''}}" wx:for="{{item.devices}}" wx:for-item="dev" wx:key="deviceID" data-deviceid="{{dev.deviceID}}" data-accountid="{{item.account_id}}" bind:tap="selectDevice">
            <view class="w-5 h-5 rounded-full border-2 flex items-center justify-center mr-3 {{did === dev.deviceID ? 'border-blue-500' : 'border-gray-300'}}">
              <view wx:if="{{did === dev.deviceID}}" class="w-2.5 h-2.5 rounded-full bg-blue-500"></view>
            </view>
            <text class="text-sm {{did === dev.deviceID ? 'text-blue-600 font-medium' : ''}}">🔊 {{dev.name}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view class="mt-4">
    <view class="text-xs text-gray-400 uppercase mb-2">播放</view>
    <view class="bg-white dark:bg-gray-800/20 rounded-xl p-3">
      <view class="flex justify-between items-center py-2">
        <text class="text-sm">后台播放</text>
        <switch class="scale-75" type="checkbox" checked="{{bgAudio}}" bind:change="handleBgAudioChange" />
      </view>
    </view>
  </view>

  <view class="mt-4">
    <view class="text-xs text-gray-400 uppercase mb-2">关于</view>
    <view class="bg-white dark:bg-gray-800/20 rounded-xl p-3">
      <view class="flex justify-between items-center py-2">
        <text class="text-sm">版本</text>
        <text class="text-sm text-gray-500">{{version}}</text>
      </view>
      <view class="flex items-center py-2 border-t border-gray-100 dark:border-gray-700/50">
        <text class="text-sm text-gray-400">基于 卯卯音乐 二次开发</text>
        <text class="text-sm ml-1 text-blue-500" data-url="https://github.com/F-loat/xiaoplayer" bind:tap="openLink">GitHub</text>
      </view>
    </view>
  </view>

  <view class="mt-8 flex flex-col gap-3">
    <button class="w-full py-2.5 rounded-lg text-sm text-white bg-red-500" bind:tap="handleLogout">退出登录</button>
    <button class="w-full py-2.5 rounded-lg text-sm text-gray-500 bg-white dark:bg-gray-800/20" bind:tap="handleRestartServer">重新初始化服务器</button>
  </view>
</scroll-view>
