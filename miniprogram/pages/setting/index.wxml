<navigation-bar title="设置" />

<scroll-view class="flex-1 overflow-y-hidden px-3 box-border" scroll-y show-scrollbar="{{false}}">
  <view class="mt-4">
    <view class="text-xs text-gray-400 uppercase mb-2">服务器</view>
    <view class="bg-white dark:bg-gray-800/20 rounded-xl p-3">
      <view class="flex justify-between items-center py-2">
        <text class="text-sm">服务器地址</text>
        <text class="text-sm text-gray-500 truncate max-w-[200px]">{{serverUrl}}</text>
      </view>
    </view>
  </view>

  <view class="mt-4">
    <view class="text-xs text-gray-400 uppercase mb-2">设备</view>
    <view class="bg-white dark:bg-gray-800/20 rounded-xl p-3">
      <view class="flex justify-between items-center py-2">
        <text class="text-sm">Miot 插件</text>
        <text class="text-sm" wx:if="{{hasMiot}}">已连接</text>
        <text class="text-sm text-gray-500" wx:else>未检测到</text>
      </view>
      <view class="flex justify-between items-center py-2">
        <text class="text-sm">当前模式</text>
        <text class="text-sm">{{did === 'host' ? '本机播放' : '音箱投播'}}</text>
      </view>
    </view>
  </view>

  <view class="mt-4">
    <view class="text-xs text-gray-400 uppercase mb-2">关于</view>
    <view class="bg-white dark:bg-gray-800/20 rounded-xl p-3">
      <view class="flex justify-between items-center py-2">
        <text class="text-sm">版本</text>
        <text class="text-sm text-gray-500">{{version}}</text>
      </view>
      <view class="flex items-center py-2 border-t border-gray-100 dark:border-gray-700/50">
        <text class="text-sm text-gray-400">基于 卯卯音乐 二次开发</text>
        <text class="text-sm ml-1 text-blue-500" data-url="https://github.com/F-loat/xiaoplayer" bind:tap="openLink">GitHub</text>
      </view>
    </view>
  </view>

  <view class="mt-8 flex flex-col gap-3">
    <button class="w-full py-2.5 rounded-lg text-sm text-white bg-red-500" bind:tap="handleLogout">退出登录</button>
    <button class="w-full py-2.5 rounded-lg text-sm text-gray-500 bg-white dark:bg-gray-800/20" bind:tap="handleRestartServer">重新初始化服务器</button>
  </view>
</scroll-view>
