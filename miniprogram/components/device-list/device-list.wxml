<block wx:if="{{deviceList.length > 0}}">
  <view class="text-base font-bold my-3">设备</view>
  <block wx:for="{{deviceGroups}}" wx:key="account_id" wx:for-index="gIndex">
    <block wx:for="{{item.devices}}" wx:key="deviceID">
      <view class="flex items-center p-2.5 rounded-md mb-1 transition-colors {{item.deviceID === did ? 'bg-blue-50 dark:bg-blue-900/20 border border-blue-400/30' : 'bg-white dark:bg-gray-800/20'}}"
        data-deviceid="{{item.deviceID}}" data-gindex="{{gIndex}}" bind:tap="handleSwitchDevice">
        <view class="flex-1 min-w-0">
          <view class="text-sm font-medium truncate">{{item.name}}</view>
          <view class="text-xs text-gray-400 truncate">{{item.model || ''}}</view>
        </view>
        <view wx:if="{{item.deviceID === did}}" class="w-2 h-2 rounded-full bg-blue-500 shrink-0" />
      </view>
    </block>
  </block>
</block>
